# Copy to .env on the VPS and fill in real values.
# Never commit .env

# Public hostname (no scheme). Used by Caddy for HTTPS.
DOMAIN=tracker.example.ru
ACME_EMAIL=admin@example.ru

# MariaDB
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=boevtracker
MYSQL_USER=boev
MYSQL_PASSWORD=change-me-db-password
DATABASE_URL=mysql://boev:change-me-db-password@mariadb:3306/boevtracker

# Backend
NODE_ENV=production
PORT=3001
JWT_SECRET=change-me-long-random-jwt-secret
COOKIE_SECRET=change-me-long-random-cookie-secret
CORS_ORIGIN=https://tracker.example.ru

# MinIO / S3 (internal endpoint; public URL goes through Caddy /files)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://tracker.example.ru/files
S3_REGION=us-east-1
S3_BUCKET=boevtracker
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-password

# Frontend build: empty = same-origin /api via Caddy
VITE_API_URL=
